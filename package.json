{
  "name": "dsh-robot-ear",
  "version": "0.1.1",
  "title": {
    "en": "Robot Ear",
    "zh": "机器人耳朵"
  },
  "description": "Gives DSH a pair of ears: takes a video or audio source (douyin m3u8 link, mp4 file, local audio file), pulls the audio track with ffmpeg, and turns it into a transcript with either a fully local Whisper model or any OpenAI-compatible /v1/audio/transcriptions endpoint. Ships a settings panel and three agent tools.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "client.js",
    "runner.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "assets"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "speech-to-text",
    "asr",
    "whisper",
    "ffmpeg",
    "video"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "opencc-js": "^1.4.2"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@xenova/transformers": "^2.17.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2 <0.3.0-0"
    }
  }
}